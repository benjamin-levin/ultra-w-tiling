+QRectF Window::quickTileSpanGeometry(const QPointF &startPos, const QPointF &endPos) const
+{
+    Output *startOutput = workspace()->outputAt(startPos);
+    Output *endOutput = workspace()->outputAt(endPos);
+    if (!startOutput || !endOutput || startOutput != endOutput) {
+        return quickTileGeometry(QuickTileFlag::Custom, endPos);
+    }
+
+    TileManager *manager = workspace()->tileManager(endOutput);
+    Tile *startTile = manager->bestTileForPosition(startPos);
+    Tile *endTile = manager->bestTileForPosition(endPos);
+    if (!startTile || !endTile) {
+        return QRectF();
+    }
+
+    return startTile->windowGeometry().united(endTile->windowGeometry());
+}

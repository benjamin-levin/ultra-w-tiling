+RectF Window::quickTileSpanGeometry(const QPointF &startPos, const QPointF &endPos) const
+{
+    LogicalOutput *startOutput = workspace()->outputAt(startPos);
+    LogicalOutput *endOutput = workspace()->outputAt(endPos);
+    if (!startOutput || !endOutput || startOutput != endOutput) {
+        return quickTileGeometry(QuickTileFlag::Custom, endPos);
+    }
+
+    RootTile *root = workspace()->rootTile(endOutput);
+    if (!root) {
+        return RectF();
+    }
+    Tile *startTile = root->pick(startPos);
+    Tile *endTile = root->pick(endPos);
+    if (!startTile || !endTile) {
+        return RectF();
+    }
+
+    return startTile->windowGeometry().united(endTile->windowGeometry());
+}
